import numpy as np
house_data = np.array([
    [3, 1200, 250000],
    [5, 2000, 450000],
    [6, 2500, 550000],
    [4, 1800, 350000],
    [7, 3000, 650000]
])
selected_houses = house_data[house_data[:, 0] > 4]
average_price = np.mean(selected_houses[:, 2])
print("Average sale price of houses with more than 4 bedrooms:", average_price)
